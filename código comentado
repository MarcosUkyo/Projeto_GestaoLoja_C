void registrarCompra() {                        // Funcao do menu opcao 11
    Produto p[MAX];                             // Vetor com os produtos
    Cliente c[MAX];                             // Vetor com os clientes
    Compra h[MAX], nova;                        // Vetor com o historico e a variavel da nova compra
    int np = carregarProdutos(p), nc = carregarClientes(c), nh = carregarCompras(h);    // Carrega os 3 arquivos e guarda as quantidades
    int i, idCliente, posCliente = -1, posProduto, qtd, maior = 0;  // Variaveis auxiliares (posCliente = -1 significa "nao achado")
    Produto *prod;                              // Ponteiro para o produto escolhido
    FILE *arq;                                  // Ponteiro para o arquivo de historico

    printf("ID do cliente: ");                  // Pede o ID do cliente
    idCliente = lerInt();                       // Le o ID
    for (i = 0; i < nc; i++) {                  // Percorre os clientes
        if (c[i].id == idCliente) {             // Se o ID bate...
            posCliente = i;                     // ...guarda a posicao do cliente
        }                                       // Fim do if
    }                                           // Fim do for
    if (posCliente == -1) {                     // Se nao achou o cliente...
        printf("Cliente nao encontrado!\n");    // ...avisa
        return;                                 // ...e cancela
    }                                           // Fim do if

    printf("ID do produto: ");                  // Pede o ID do produto
    posProduto = acharProduto(p, np, lerInt()); // Le o ID e procura a posicao do produto
    if (posProduto == -1) {                     // Se nao achou o produto...
        printf("Produto nao encontrado!\n");    // ...avisa
        return;                                 // ...e cancela
    }                                           // Fim do if
    prod = &p[posProduto];                      // O ponteiro aponta para o produto escolhido
    printf("Produto: %s | Preco: R$ %.2f | Estoque disponivel: %d\n", prod->nome, prod->preco, prod->quantidade);   // Mostra nome, preco e estoque

    printf("Quantidade desejada: ");            // Pede a quantidade
    qtd = lerInt();                             // Le a quantidade
    if (qtd <= 0 || qtd > prod->quantidade) {   // Se for zero/negativa ou maior que o estoque...
        printf("Quantidade invalida ou estoque insuficiente!\n");   // ...avisa
        return;                                 // ...e cancela
    }                                           // Fim do if

    // Calcula ID do historico
    for (i = 0; i < nh; i++) {                  // Percorre as compras ja registradas
        if (h[i].id > maior) {                  // Se este ID for o maior visto ate agora...
            maior = h[i].id;                    // ...guarda como maior
        }                                       // Fim do if
    }                                           // Fim do for
    nova.id = maior + 1;                        // ID da nova compra: maior + 1
    strcpy(nova.cliente, c[posCliente].nome);   // Copia o nome do cliente para a compra
    strcpy(nova.produto, prod->nome);           // Copia o nome do produto para a compra
    nova.quantidade = qtd;                      // Guarda a quantidade comprada
    nova.total = qtd * prod->preco;             // Calcula o total: quantidade x preco unitario

    // Grava no arquivo de historico
    arq = fopen("historico.txt", "a");          // Abre o historico em modo append
    if (arq == NULL) {                          // Se nao conseguiu abrir...
        printf("Erro ao abrir o historico!\n"); // ...avisa
        return;                                 // ...e cancela
    }                                           // Fim do if
    fprintf(arq, "%d;%s;%s;%d;%.2f\n", nova.id, nova.cliente, nova.produto, nova.quantidade, nova.total);   // Grava a compra: id;cliente;produto;qtd;total
    fclose(arq);                                // Fecha o arquivo

    // Atualiza o estoque do produto baixando a quantidade vendida
    prod->quantidade = prod->quantidade - qtd;  // Subtrai a quantidade vendida do estoque (na memoria)
    salvarProdutos(p, np);                      // Atualiza o arquivo de produtos com o novo estoque
    printf("Compra registrada com sucesso! Total: R$ %.2f\n", nova.total);  // Mostra o total da compra
}                                               // Fim da funcao registrarCompra

void listarHistorico() {                        // Funcao do menu opcao 12
    Compra v[MAX];                              // Vetor para as compras
    int n = carregarCompras(v), i;              // n = quantidade lida; i = contador
    float soma = 0;                             // Acumulador do faturamento total

    if (n == 0) {                               // Se nao ha compras...
        printf("Nenhuma compra registrada.\n"); // ...avisa
        return;                                 // ...e sai
    }                                           // Fim do if
    printf("\n%-5s %-20s %-20s %5s %10s\n", "ID", "CLIENTE", "PRODUTO", "QTD", "TOTAL");    // Imprime o cabecalho da tabela
    printf("-----------------------------------------------------------\n");   // Linha separadora
    for (i = 0; i < n; i++) {                   // Percorre todas as compras
        printf("%-5d %-20.20s %-20.20s %5d %10.2f\n", v[i].id, v[i].cliente, v[i].produto,  // Imprime id, cliente e produto da compra
               v[i].quantidade, v[i].total);    // Imprime quantidade e total da compra
        soma = soma + v[i].total;               // Soma o total desta compra ao faturamento
    }                                           // Fim do for
    printf("\nTotal de %d compra(s) | Faturamento total: R$ %.2f\n", n, soma);  // Mostra a quantidade de compras e o faturamento
}                                               // Fim da funcao listarHistorico

