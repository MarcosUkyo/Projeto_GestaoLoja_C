#include <stdio.h>      // Biblioteca de entrada/saida: printf, fgets, fopen, fprintf, fscanf, etc.
#include <stdlib.h>     // Biblioteca padrao: atoi, atof (converter texto em numero)
#include <string.h>     // Biblioteca de textos: strlen, strcpy, strcspn, strstr
#include <ctype.h>      // Biblioteca de caracteres: tolower

#define MAX 100         // Define a constante MAX: limite maximo de registros em cada vetor na memoria

// Estrutura para representar os Produtos
typedef struct {                // Inicia a definicao de uma struct com apelido (typedef)
    int id;                     // Identificador unico do produto
    char nome[50];              // Nome do produto (ate 49 caracteres + '\0')
    char categoria[30];         // Categoria do produto (ate 29 caracteres + '\0')
    float preco;                // Preco unitario do produto
    int quantidade;             // Estoque atual do produto
    char fornecedor[40];        // Nome do fornecedor (ate 39 caracteres + '\0')
} Produto;                      // Fim da struct: agora podemos usar "Produto" como tipo

// Estrutura para representar os Clientes
typedef struct {                // Inicia a struct de cliente
    int id;                     // Identificador unico do cliente
    char nome[50];              // Nome do cliente
    char telefone[20];          // Telefone do cliente (guardado como texto)
} Cliente;                      // Fim da struct: tipo "Cliente"

// Estrutura para representar o Historico de Compras
typedef struct {                // Inicia a struct de compra
    int id;                     // Identificador unico da compra
    char cliente[50];           // Salvamos o NOME (nao o ID) para nao perder o historico se o cliente for apagado
    char produto[50];           // Nome do produto comprado (mesmo motivo acima)
    int quantidade;             // Quantidade de unidades compradas
    float total;                // Valor total da compra (quantidade * preco)
} Compra;                       // Fim da struct: tipo "Compra"

