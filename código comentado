void inserirCliente() {                         // Funcao do menu opcao 9
    Cliente v[MAX], novo;                       // Vetor com clientes existentes e variavel do novo cliente
    int n = carregarClientes(v), i, maior = 0;  // n = quantidade; i = contador; maior = maior ID encontrado
    FILE *arq;                                  // Ponteiro para o arquivo

    if (n >= MAX) {                             // Se o vetor ja esta cheio...
        printf("Limite de clientes atingido!\n");   // ...avisa
        return;                                 // ...e cancela
    }                                           // Fim do if
    printf("Nome: ");                           // Pede o nome
    lerTexto(novo.nome, 50);                    // Le o nome
    printf("Telefone: ");                       // Pede o telefone
    lerTexto(novo.telefone, 20);                // Le o telefone
    if (strlen(novo.nome) == 0 || strlen(novo.telefone) == 0) {     // Se nome OU telefone estiverem vazios...
        printf("Nome e telefone nao podem ficar vazios!\n");        // ...avisa
        return;                                 // ...e cancela
    }                                           // Fim do if
    for (i = 0; i < n; i++) {                   // Percorre os clientes ja cadastrados
        if (comparar(v[i].nome, novo.nome) == 0) {          // Se o nome ja existe (ignorando maiusculas)...
            printf("Esse cliente ja esta cadastrado!\n");   // ...avisa
            return;                             // ...e cancela
        }                                       // Fim do if
        if (v[i].id > maior) {                  // Se este ID for o maior visto ate agora...
            maior = v[i].id;                    // ...guarda como maior
        }                                       // Fim do if
    }                                           // Fim do for
    novo.id = maior + 1;                        // ID automatico: maior existente + 1

    arq = fopen("clientes.txt", "a");           // Abre o arquivo em modo append (adiciona no final)
    if (arq == NULL) {                          // Se nao conseguiu abrir...
        printf("Erro ao abrir o arquivo!\n");   // ...avisa
        return;                                 // ...e cancela
    }                                           // Fim do if
    fprintf(arq, "%d;%s;%s\n", novo.id, novo.nome, novo.telefone);  // Grava uma linha: id;nome;telefone
    fclose(arq);                                // Fecha o arquivo
    printf("Cliente cadastrado com o ID %d!\n", novo.id);   // Informa o ID gerado
}                                               // Fim da funcao inserirCliente

