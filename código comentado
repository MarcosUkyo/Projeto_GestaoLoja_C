// Le um texto do teclado com seguranca (substitui o scanf de strings)
void lerTexto(char *texto, int tam) {   // Recebe o endereco do vetor de char e o tamanho maximo
    int i;                              // Contador usado no laco que percorre o texto
    fgets(texto, tam, stdin);           // Le a linha inteira do teclado, sem estourar o tamanho
    texto[strcspn(texto, "\n")] = '\0'; // Acha a posicao do '\n' e troca por '\0' (remove a quebra de linha)

    // O ponto e virgula (;) e o nosso delimitador nos arquivos txt, entao evitamos conflito
    for (i = 0; texto[i] != '\0'; i++) {    // Percorre cada caractere ate o fim do texto
        if (texto[i] == ';') {              // Se o caractere atual for ponto e virgula...
            texto[i] = ' ';                 // ...troca por espaco para nao quebrar o formato do arquivo
        }                                   // Fim do if
    }                                       // Fim do for
}                                           // Fim da funcao lerTexto

// Le um numero inteiro de forma segura convertendo de string
int lerInt() {                      // Funcao sem parametros que devolve um inteiro
    char buffer[50] = "0";          // Vetor temporario iniciado com "0" (valor padrao se nada for lido)
    fgets(buffer, 50, stdin);       // Le a linha digitada como texto
    return atoi(buffer);            // Converte o texto para int e devolve (atoi retorna 0 se for invalido)
}                                   // Fim da funcao lerInt

// Le um numero real aceitando virgula ou ponto
float lerFloat() {                  // Funcao que devolve um numero decimal
    char buffer[50] = "0";          // Vetor temporario iniciado com "0"
    int i;                          // Contador para percorrer o texto
    fgets(buffer, 50, stdin);       // Le a linha digitada como texto
    for (i = 0; buffer[i] != '\0'; i++) {   // Percorre cada caractere do texto
        if (buffer[i] == ',') {             // Se encontrar uma virgula...
            buffer[i] = '.';                // ...troca por ponto: padroniza virgula para ponto (padrao float em C)
        }                                   // Fim do if
    }                                       // Fim do for
    return atof(buffer);            // Converte o texto para float e devolve
}                                   // Fim da funcao lerFloat

// Converte caractere para minusculo (evitando problemas com acentos via cast)
char minus(char c) {                    // Recebe um caractere e devolve outro
    return tolower((unsigned char)c);   // Converte para minusculo; o cast evita comportamento indefinido com acentos
}                                       // Fim da funcao minus

// Compara dois textos ignorando maiusculas e minusculas (Retorna 0 se iguais)
int comparar(char *a, char *b) {        // Recebe dois textos a comparar
    int i = 0;                          // Posicao atual da comparacao, comeca no inicio
    while (a[i] != '\0' && minus(a[i]) == minus(b[i])) {    // Enquanto 'a' nao acabou e os caracteres (minusculos) forem iguais
        i++;                            // Avanca para o proximo caractere
    }                                   // Fim do while: parou na primeira diferenca ou no fim de 'a'
    return minus(a[i]) - minus(b[i]);   // Devolve a diferenca: 0 = iguais, >0 = a vem depois, <0 = a vem antes
}                                       // Fim da funcao comparar

// Verifica se um pedaco de texto esta dentro de outro (Case-insensitive)
int contem(char *texto, char *pedaco) {     // Recebe o texto completo e o trecho procurado
    char t[50], p[50];                      // Copias temporarias em minusculo
    int i;                                  // Contador dos lacos
    for (i = 0; texto[i] != '\0'; i++) t[i] = minus(texto[i]);  // Copia o texto inteiro convertendo para minusculo
    t[i] = '\0';                            // Coloca o terminador de string no fim da copia
    for (i = 0; pedaco[i] != '\0'; i++) p[i] = minus(pedaco[i]);    // Copia o trecho convertendo para minusculo
    p[i] = '\0';                            // Coloca o terminador de string no fim da copia
    return strstr(t, p) != NULL;            // strstr busca substring: 1 se encontrou, 0 se nao
}                                           // Fim da funcao contem

