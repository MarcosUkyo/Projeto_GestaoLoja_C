// Carrega os dados do produtos.txt para o vetor na memoria
int carregarProdutos(Produto *v) {              // Recebe o vetor onde os produtos serao guardados
    FILE *arq = fopen("produtos.txt", "r");     // Abre o arquivo para leitura ("r")
    int n = 0;                                  // Contador de produtos lidos
    if (arq == NULL) {                          // Se o arquivo nao abriu...
        return 0;                               // ...ele ainda nao existe: devolve 0 produtos
    }                                           // Fim do if
    // Le linha por linha usando mascara de formato especifica para arquivos txt estruturados
    while (n < MAX && fscanf(arq, "%d;%49[^;];%29[^;];%f;%d;%39[^\n]\n", &v[n].id, v[n].nome,   // Enquanto couber no vetor, le id, nome (ate ';'), categoria...
                           v[n].categoria, &v[n].preco, &v[n].quantidade, v[n].fornecedor) == 6) {  // ...preco, quantidade e fornecedor; so continua se leu os 6 campos
        n++;                                    // Conta mais um produto lido
    }                                           // Fim do while
    fclose(arq);                                // Fecha o arquivo
    return n;                                   // Devolve quantos produtos foram carregados
}                                               // Fim da funcao carregarProdutos

// Tecnica de seguranca: Regrava produtos.txt usando um arquivo temporario
void salvarProdutos(Produto *v, int n) {        // Recebe o vetor e quantos produtos ele tem
    FILE *temp = fopen("temp.txt", "w");        // Cria/abre um arquivo temporario para escrita
    int i;                                      // Contador do laco
    if (temp == NULL) {                         // Se nao conseguiu criar o temporario...
        printf("Erro ao criar arquivo temporario!\n");  // ...avisa o usuario
        return;                                 // ...e sai da funcao sem mexer no arquivo original
    }                                           // Fim do if
    for (i = 0; i < n; i++) {                   // Percorre todos os produtos do vetor
        fprintf(temp, "%d;%s;%s;%.2f;%d;%s\n", v[i].id, v[i].nome, v[i].categoria,  // Escreve uma linha por produto, campos separados por ';'
                v[i].preco, v[i].quantidade, v[i].fornecedor);  // Preco com 2 casas decimais
    }                                           // Fim do for
    fclose(temp);                               // Fecha o temporario (garante que tudo foi gravado)
    remove("produtos.txt");                     // Apaga o arquivo original corrompido ou desatualizado
    rename("temp.txt", "produtos.txt");         // Renomeia o temporario para se tornar o oficial
}                                               // Fim da funcao salvarProdutos

// Carrega os dados de clientes.txt
int carregarClientes(Cliente *v) {              // Recebe o vetor onde os clientes serao guardados
    FILE *arq = fopen("clientes.txt", "r");     // Abre o arquivo de clientes para leitura
    int n = 0;                                  // Contador de clientes lidos
    if (arq == NULL) {                          // Se o arquivo nao existe...
        return 0;                               // ...devolve 0 clientes
    }                                           // Fim do if
    while (n < MAX && fscanf(arq, "%d;%49[^;];%19[^\n]\n", &v[n].id, v[n].nome, v[n].telefone) == 3) {  // Le id, nome e telefone; continua enquanto leu os 3 campos
        n++;                                    // Conta mais um cliente
    }                                           // Fim do while
    fclose(arq);                                // Fecha o arquivo
    return n;                                   // Devolve quantos clientes foram carregados
}                                               // Fim da funcao carregarClientes

// Carrega os dados de historico.txt
int carregarCompras(Compra *v) {                // Recebe o vetor onde as compras serao guardadas
    FILE *arq = fopen("historico.txt", "r");    // Abre o arquivo de historico para leitura
    int n = 0;                                  // Contador de compras lidas
    if (arq == NULL) {                          // Se o arquivo nao existe...
        return 0;                               // ...devolve 0 compras
    }                                           // Fim do if
    while (n < MAX && fscanf(arq, "%d;%49[^;];%49[^;];%d;%f\n", &v[n].id, v[n].cliente,     // Le id, nome do cliente...
                           v[n].produto, &v[n].quantidade, &v[n].total) == 5) {             // ...nome do produto, quantidade e total; so continua se leu os 5 campos
        n++;                                    // Conta mais uma compra
    }                                           // Fim do while
    fclose(arq);                                // Fecha o arquivo
    return n;                                   // Devolve quantas compras foram carregadas
}                                               // Fim da funcao carregarCompras

// Cria os 3 arquivos principais vazios (Zera a base de dados se confirmado)
void criarArquivos() {                          // Funcao do menu opcao 1
    FILE *arq;                                  // Ponteiro de arquivo reutilizado para os 3 arquivos
    char resp[10];                              // Guarda a resposta s/n do usuario

    printf("Isso apaga tudo que ja existe. Continuar? (s/n): ");     // Pede confirmacao porque os dados serao apagados
    lerTexto(resp, 10);                         // Le a resposta do teclado
    if (minus(resp[0]) != 's') {                // Se a primeira letra (em minusculo) nao for 's'...
        printf("Cancelado.\n");                 // ...avisa que foi cancelado
        return;                                 // ...e sai sem apagar nada
    }                                           // Fim do if
    arq = fopen("produtos.txt", "w");           // Modo "w" limpa ou cria arquivo vazio
    if (arq != NULL) fclose(arq);               // Se abriu, fecha logo em seguida (o arquivo fica vazio)
    arq = fopen("clientes.txt", "w");           // Mesmo processo para clientes.txt
    if (arq != NULL) fclose(arq);               // Fecha o arquivo de clientes
    arq = fopen("historico.txt", "w");          // Mesmo processo para historico.txt
    if (arq != NULL) fclose(arq);               // Fecha o arquivo de historico
    printf("Arquivos criados com sucesso!\n");  // Informa que terminou
}                                               // Fim da funcao criarArquivos

// ---------------------------------------------------------
// FUNCOES DE PRODUTOS
// ---------------------------------------------------------

int acharProduto(Produto *v, int n, int id) {   // Procura um produto pelo ID no vetor
    int i;                                      // Contador do laco
    for (i = 0; i < n; i++) {                   // Percorre todos os produtos
        if (v[i].id == id) {                    // Se o ID do produto atual for o procurado...
            return i;                           // Retorna o indice no vetor
        }                                       // Fim do if
    }                                           // Fim do for
    return -1;                                  // Nao encontrado: devolve -1
}                                               // Fim da funcao acharProduto

void cabecalhoProdutos() {                      // Imprime o cabecalho da tabela de produtos
    printf("\n%-5s %-25s %-18s %10s %6s  %-15s\n", "ID", "NOME", "CATEGORIA", "PRECO", "QTD", "FORNECEDOR");  // Titulos das colunas com larguras fixas (- = alinhado a esquerda)
    printf("-------------------------------------------------------------------------------------\n");     // Linha separadora
}                                               // Fim da funcao cabecalhoProdutos

void linhaProduto(Produto *p) {                 // Imprime uma linha da tabela para um produto
    printf("%-5d %-25.25s %-18.18s %10.2f %6d  %-15.15s\n", p->id, p->nome, p->categoria,   // Mostra id, nome e categoria (".25" corta textos maiores que a coluna)
           p->preco, p->quantidade, p->fornecedor);     // Mostra preco com 2 casas, quantidade e fornecedor
}                                               // Fim da funcao linhaProduto

void mostrarProdutos(Produto *v, int n) {       // Mostra a tabela completa de produtos
    int i;                                      // Contador do laco
    cabecalhoProdutos();                        // Imprime o cabecalho da tabela
    for (i = 0; i < n; i++) {                   // Percorre todos os produtos
        linhaProduto(&v[i]);                    // Imprime uma linha passando o endereco do produto
    }                                           // Fim do for
    printf("\nTotal: %d produto(s)\n", n);      // Mostra o total de produtos listados
}                                               // Fim da funcao mostrarProdutos

void inserirProduto() {                         // Funcao do menu opcao 2
    Produto v[MAX], novo;                       // Vetor com os produtos existentes e a variavel do novo produto
    int n = carregarProdutos(v), i, maior = 0;  // n = quantos ja existem; i = contador; maior = maior ID encontrado
    FILE *arq;                                  // Ponteiro para o arquivo

    if (n >= MAX) {                             // Se o vetor ja esta cheio...
        printf("Limite de produtos atingido!\n");   // ...avisa o usuario
        return;                                 // ...e cancela o cadastro
    }                                           // Fim do if
    printf("Nome: ");                           // Pede o nome
    lerTexto(novo.nome, 50);                    // Le o nome do teclado
    printf("Categoria: ");                      // Pede a categoria
    lerTexto(novo.categoria, 30);               // Le a categoria do teclado
    if (strlen(novo.nome) == 0 || strlen(novo.categoria) == 0) {    // Se nome OU categoria estiverem vazios...
        printf("Nome e categoria nao podem ficar vazios!\n");       // ...avisa o erro
        return;                                 // ...e cancela
    }                                           // Fim do if
    printf("Preco: ");                          // Pede o preco
    novo.preco = lerFloat();                    // Le o preco (aceita virgula ou ponto)
    printf("Quantidade: ");                     // Pede a quantidade em estoque
    novo.quantidade = lerInt();                 // Le a quantidade
    printf("Fornecedor: ");                     // Pede o fornecedor
    lerTexto(novo.fornecedor, 40);              // Le o fornecedor
    if (strlen(novo.fornecedor) == 0) {         // Se o fornecedor estiver vazio...
        printf("Fornecedor nao pode ficar vazio!\n");   // ...avisa o erro
        return;                                 // ...e cancela
    }                                           // Fim do if

    // Valida duplicidade e calcula ID sequencial automatico
    for (i = 0; i < n; i++) {                   // Percorre os produtos ja cadastrados
        if (comparar(v[i].nome, novo.nome) == 0) {          // Se o nome for igual (ignorando maiusculas)...
            printf("Esse produto ja esta cadastrado!\n");   // ...avisa que e duplicado
            return;                             // ...e cancela
        }                                       // Fim do if
        if (v[i].id > maior) {                  // Se este ID for maior que o maior visto ate agora...
            maior = v[i].id;                    // ...guarda como novo maior
        }                                       // Fim do if
    }                                           // Fim do for
    novo.id = maior + 1;                        // ID automatico incremental (maior existente + 1)

    arq = fopen("produtos.txt", "a");           // Modo "a" (append) adiciona no final do arquivo
    if (arq == NULL) {                          // Se nao conseguiu abrir...
        printf("Erro ao abrir o arquivo!\n");   // ...avisa o erro
        return;                                 // ...e cancela
    }                                           // Fim do if
    fprintf(arq, "%d;%s;%s;%.2f;%d;%s\n", novo.id, novo.nome, novo.categoria,   // Grava uma linha com os campos separados por ';'
            novo.preco, novo.quantidade, novo.fornecedor);  // Continuacao dos campos gravados
    fclose(arq);                                // Fecha o arquivo
    printf("Produto cadastrado com o ID %d!\n", novo.id);   // Informa o ID gerado
}                                               // Fim da funcao inserirProduto

void listarProdutos() {                         // Funcao do menu opcao 3
    Produto v[MAX];                             // Vetor para guardar os produtos lidos
    int n = carregarProdutos(v);                // Carrega do arquivo e guarda a quantidade
    if (n == 0) {                               // Se nao ha produtos...
        printf("Nenhum produto cadastrado.\n"); // ...avisa
        return;                                 // ...e sai
    }                                           // Fim do if
    mostrarProdutos(v, n);                      // Exibe a tabela de produtos
}                                               // Fim da funcao listarProdutos

void alterarProduto() {                         // Funcao do menu opcao 4
    Produto v[MAX];                             // Vetor com todos os produtos
    int n = carregarProdutos(v), i, pos;        // n = quantidade; i = contador; pos = posicao do produto escolhido
    Produto *p;                                 // Ponteiro para editar o produto escolhido direto no vetor
    char nome[50];                              // Guarda o novo nome ate validar

    printf("ID do produto: ");                  // Pede o ID do produto a alterar
    pos = acharProduto(v, n, lerInt());         // Le o ID e procura a posicao dele no vetor
    if (pos == -1) {                            // Se nao achou...
        printf("Produto nao encontrado!\n");    // ...avisa
        return;                                 // ...e sai
    }                                           // Fim do if
    p = &v[pos];                                // O ponteiro passa a apontar para o produto encontrado

    printf("Novo nome: ");                      // Pede o novo nome
    lerTexto(nome, 50);                         // Le o novo nome na variavel temporaria
    for (i = 0; i < n; i++) {                   // Percorre todos os produtos para checar duplicidade
        if (i != pos && comparar(v[i].nome, nome) == 0) {   // Se OUTRO produto (i != pos) ja tem esse nome...
            printf("Ja existe outro produto com esse nome!\n"); // ...avisa
            return;                             // ...e cancela
        }                                       // Fim do if
    }                                           // Fim do for
    printf("Nova categoria: ");                 // Pede a nova categoria
    lerTexto(p->categoria, 30);                 // Le direto na categoria do produto (via ponteiro)
    printf("Novo fornecedor: ");                // Pede o novo fornecedor
    lerTexto(p->fornecedor, 40);                // Le direto no fornecedor do produto
    if (strlen(nome) == 0 || strlen(p->categoria) == 0 || strlen(p->fornecedor) == 0) {     // Se algum campo de texto estiver vazio...
        printf("Campos nao podem ficar vazios!\n");     // ...avisa
        return;                                 // ...e cancela sem salvar (o arquivo nao foi alterado ainda)
    }                                           // Fim do if
    strcpy(p->nome, nome);                      // Copia o novo nome validado para o produto
    printf("Novo preco: ");                     // Pede o novo preco
    p->preco = lerFloat();                      // Le e grava o preco no produto
    printf("Nova quantidade: ");                // Pede a nova quantidade
    p->quantidade = lerInt();                   // Le e grava a quantidade no produto

    salvarProdutos(v, n);                       // Grava as mudancas usando arquivo temporario
    printf("Produto alterado com sucesso!\n");  // Informa o sucesso
}                                               // Fim da funcao alterarProduto

void excluirProduto() {                         // Funcao do menu opcao 5
    Produto v[MAX];                             // Vetor com todos os produtos
    int n = carregarProdutos(v), i, pos;        // n = quantidade; i = contador; pos = posicao a excluir

    printf("ID do produto: ");                  // Pede o ID do produto a excluir
    pos = acharProduto(v, n, lerInt());         // Le o ID e procura a posicao
    if (pos == -1) {                            // Se nao achou...
        printf("Produto nao encontrado!\n");    // ...avisa
        return;                                 // ...e sai
    }                                           // Fim do if
    // Desloca os elementos seguintes para cobrir a posicao excluida
    for (i = pos; i < n - 1; i++) {             // Do ponto excluido ate o penultimo elemento
        v[i] = v[i + 1];                        // Copia o proximo elemento para a posicao atual
    }                                           // Fim do for
    salvarProdutos(v, n - 1);                   // Salva o vetor reduzindo o tamanho em 1
    printf("Produto excluido!\n");              // Informa o sucesso
}                                               // Fim da funcao excluirProduto

void buscarProduto() {                          // Funcao do menu opcao 6
    Produto v[MAX];                             // Vetor com todos os produtos
    int n = carregarProdutos(v), i, tipo, achou = 0;    // n = quantidade; i = contador; tipo = campo de busca; achou = quantos encontrados
    char busca[50];                             // Texto digitado para pesquisar

    printf("Buscar por: 1 - nome | 2 - categoria | 3 - fornecedor: ");  // Mostra as opcoes de busca
    tipo = lerInt();                            // Le a opcao escolhida
    printf("Digite o texto de busca: ");        // Pede o texto a procurar
    lerTexto(busca, 50);                        // Le o texto de busca

    for (i = 0; i < n; i++) {                   // Percorre todos os produtos
        if ((tipo == 1 && contem(v[i].nome, busca)) ||          // Se busca por nome e o nome contem o texto, OU...
            (tipo == 2 && contem(v[i].categoria, busca)) ||     // ...busca por categoria e a categoria contem o texto, OU...
            (tipo == 3 && contem(v[i].fornecedor, busca))) {    // ...busca por fornecedor e o fornecedor contem o texto
            if (achou == 0) {                   // Se for o primeiro encontrado...
                cabecalhoProdutos();            // ...imprime o cabecalho da tabela uma unica vez
            }                                   // Fim do if
            linhaProduto(&v[i]);                // Imprime a linha do produto encontrado
            achou++;                            // Conta mais um encontrado
        }                                       // Fim do if
    }                                           // Fim do for
    if (achou == 0) {                           // Se nenhum produto foi encontrado...
        printf("Nenhum produto encontrado.\n"); // ...avisa
    }                                           // Fim do if
}                                               // Fim da funcao buscarProduto

// ---------------------------------------------------------
// ALGORITMO DE ORDENACAO: BUBBLE SORT
// ---------------------------------------------------------
void bubbleSort(Produto *v, int n, int criterio) {     // Ordena o vetor v de n produtos conforme o criterio (1 a 4)
    int i, j, trocar;                           // i = rodada; j = posicao comparada; trocar = decide se troca (1) ou nao (0)
    Produto aux;                                // Variavel auxiliar para realizar a troca de dois produtos

    // O algoritmo da bolha compara elementos vizinhos e empurra os maiores/menores para o fim
    for (i = 0; i < n - 1; i++) {               // Repete n-1 rodadas completas
        for (j = 0; j < n - 1 - i; j++) {       // Compara pares vizinhos (a cada rodada o ultimo ja esta no lugar, por isso "- i")
            if (criterio == 1) trocar = comparar(v[j].nome, v[j + 1].nome) > 0;         // Criterio 1 (A-Z): troca se o atual vier depois do proximo
            else if (criterio == 2) trocar = comparar(v[j].nome, v[j + 1].nome) < 0;    // Criterio 2 (Z-A): troca se o atual vier antes do proximo
            else if (criterio == 3) trocar = v[j].preco > v[j + 1].preco;               // Criterio 3 (menor -> maior): troca se o atual for mais caro
            else trocar = v[j].preco < v[j + 1].preco;                                  // Criterio 4 (maior -> menor): troca se o atual for mais barato

            if (trocar) {                       // Se precisa trocar, realiza a troca fisica na memoria RAM
                aux = v[j];                     // Guarda o produto atual na variavel auxiliar
                v[j] = v[j + 1];                // Coloca o proximo produto na posicao atual
                v[j + 1] = aux;                 // Coloca o produto guardado na posicao seguinte
            }                                   // Fim do if
        }                                       // Fim do for interno
    }                                           // Fim do for externo
}                                               // Fim da funcao bubbleSort

void ordenarProdutos() {                        // Funcao do menu opcao 7
    Produto v[MAX];                             // Vetor com os produtos
    int n = carregarProdutos(v), criterio;      // n = quantidade; criterio = tipo de ordenacao escolhido

    if (n == 0) {                               // Se nao ha produtos...
        printf("Nenhum produto cadastrado.\n"); // ...avisa
        return;                                 // ...e sai
    }                                           // Fim do if
    printf("1 - Nome A-Z\n2 - Nome Z-A\n3 - Preco menor -> maior\n4 - Preco maior -> menor\n");  // Mostra as opcoes de ordenacao
    printf("Ordenar por criterio: ");           // Pede a escolha
    criterio = lerInt();                        // Le a opcao
    if (criterio < 1 || criterio > 4) {         // Se a opcao estiver fora de 1 a 4...
        printf("Opcao invalida!\n");            // ...avisa
        return;                                 // ...e sai
    }                                           // Fim do if
    bubbleSort(v, n, criterio);                 // Executa o Bubble Sort
    mostrarProdutos(v, n);                      // Mostra ordenado apenas na tela (o arquivo original nao muda)
}                                               // Fim da funcao ordenarProdutos

